package-as: MarketWall

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Ignoring the generated CHANGELOG.md keeps it out of the zip, so the packager reads it
# from the checkout unprocessed instead of replacing @keywords@ and line endings in it.
ignore:
  - CHANGELOG.md
  - spec
  - flake.nix
  - flake.lock
  - Makefile
  - CONTRIBUTING.md
  - CODE_OF_CONDUCT.md
  - SECURITY.md
